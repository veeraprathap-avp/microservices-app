{
  "name": "api-gateway",
  "version": "1.0.0",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:coverage": "jest --coverage --forceExit --detectOpenHandles"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/http-proxy": "^9.4.0",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.5.0",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "fast-json-stringify": "^5.14.1",
    "pino": "^8.18.0",
    "pino-pretty": "^11.2.2",
    "undici": "^6.19.7",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "babel-jest": "^30.4.1",
    "jest": "^30.4.1",
    "jsonwebtoken": "^9.0.3",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80
      }
    }
  }
}
